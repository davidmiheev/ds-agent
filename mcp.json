{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"],
      "timeout": 15000
    },
    "colab": {
      "command": "${ROOT}/src/colab_mcp/.venv/bin/python",
      "args": ["-m", "colab_mcp.colab_server"],
      "timeout": 120000,
      "env": {
        "PYTHONPATH": "${ROOT}/src"
      }
    },
    "research": {
      "command": "${ROOT}/.venv/bin/python",
      "args": ["-m", "research_mcp.server"],
      "timeout": 30000,
      "env": {
        "PYTHONPATH": "${ROOT}/src"
      }
    },
    "ds": {
      "command": "${ROOT}/.venv/bin/python",
      "args": ["-m", "ds_mcp.server"],
      "timeout": 600000,
      "env": {
        "PYTHONPATH": "${ROOT}/src",
        "DS_PYTHON": "${DATA_DIR}/ds-env/bin/python"
      }
    },
    "memory": {
      "command": "${ROOT}/.venv/bin/python",
      "args": ["-m", "ds_agent.agent_mcp"],
      "timeout": 30000,
      "env": {
        "PYTHONPATH": "${ROOT}/src"
      }
    },
    "kaggle": {
      "command": "npx",
      "args": [
        "-y", "mcp-remote", "https://www.kaggle.com/mcp",
        "--header", "Authorization: Bearer ${VAULT:kaggle}"
      ],
      "timeout": 60000
    }
  }
}
