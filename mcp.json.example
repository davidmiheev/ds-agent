{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"],
      "timeout": 15000
    },
    "colab": {
      "command": "${ROOT}/.venv-313/bin/python",
      "args": ["-m", "colab_mcp.colab_server"],
      "timeout": 120000,
      "env": {
        "PYTHONPATH": "${ROOT}/src",
        "REQUESTS_CA_BUNDLE": "/etc/ssl/certs/agent-identity/sandbox-gateway-ca.crt"
      }
    },
    "ds": {
      "command": "${ROOT}/.venv/bin/python",
      "args": ["-m", "ds_mcp.server"],
      "timeout": 600000,
      "env": {
        "PYTHONPATH": "${ROOT}/src",
        "DS_PYTHON": "${DATA_DIR}/ds-env/bin/python"
      }
    },
    "kaggle": {
      "command": "npx",
      "args": [
        "-y", "mcp-remote", "https://www.kaggle.com/mcp",
        "--header", "Authorization: Bearer ${VAULT:kaggle}"
      ],
      "timeout": 60000
    }
  }
}
