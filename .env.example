# ds-agent environment configuration (copied to .env)
# Sourced by scripts/run_server.sh — never commit real keys to git.

# ---------------------------------------------------------------- LLM Providers
# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Anthropic Direct API Key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# MiniMax API Key (https://api.minimaxi.chat/)
MINIMAX_API_KEY=

# ------------------------------------------------------------------ MCP Servers
# Kaggle API Token for Kaggle MCP (kaggle.com -> Settings -> Create New Token, starts with KGAT...)
KAGGLE_API_TOKEN=

# Kaggle CLI credentials (for bash CLI / dataset downloading)
KAGGLE_USERNAME=
KAGGLE_KEY=

# FRED API Key for Federal Reserve Economic Data MCP (free at https://fred.stlouisfed.org)
FRED_API_KEY=

# HuggingFace Token for Model/Dataset Search MCP (https://huggingface.co/settings/tokens)
HF_TOKEN=

# --------------------------------------------------------------------- Telegram
# Bot token from @BotFather — also enables the Telegram bot bridge (see README).
TELEGRAM_BOT_TOKEN=

# Optional whitelist of Telegram user IDs allowed to use the bot (comma-separated).
TELEGRAM_ALLOWED_USERS=

# Chat that receives web-login one-time codes (see APP_PASSWORD below). Only
# needed if TELEGRAM_ALLOWED_USERS has more than one entry — with exactly one
# allowed user, their chat id is used automatically.
TELEGRAM_OTP_CHAT_ID=

# ---------------------------------------------------------------- Server Config
# Single-user login password, used only when Telegram OTP login isn't
# configured (TELEGRAM_BOT_TOKEN + a resolvable OTP chat — see above). Leave
# both unset for localhost passwordless mode.
APP_PASSWORD=

# "1" for public-host hardening (Secure cookies, login required)
APP_PUBLIC=0

# Per-session spend cap in USD
MAX_BUDGET_USD=5.0
